<?xml version="1.0"?>
<materialx version="1.39">
  <!-- Edit this file while the demo runs (File ▸ Open a copy): every output is re-stitched on save. -->
  <nodegraph name="checker">
    <texcoord name="uv" type="vector2" />
    <multiply name="scaled" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="6" /></multiply>
    <floor name="cells" type="vector2"><input name="in" type="vector2" nodename="scaled" /></floor>
    <dotproduct name="sum" type="float"><input name="in1" type="vector2" nodename="cells" /><input name="in2" type="vector2" value="1, 1" /></dotproduct>
    <modulo name="parity" type="float"><input name="in1" type="float" nodename="sum" /><input name="in2" type="float" value="2" /></modulo>
    <mix name="out_color" type="color3">
      <input name="fg" type="color3" value="0.9, 0.85, 0.7" /><input name="bg" type="color3" value="0.1, 0.15, 0.3" />
      <input name="mix" type="float" nodename="parity" />
    </mix>
    <output name="out" type="color3" nodename="out_color" />
  </nodegraph>
  <nodegraph name="rainbow">
    <texcoord name="uv" type="vector2" />
    <separate2 name="parts" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <combine3 name="hsv" type="color3">
      <input name="in1" type="float" nodename="parts" output="outx" />
      <input name="in2" type="float" nodename="parts" output="outy" />
      <input name="in3" type="float" value="1" />
    </combine3>
    <hsvtorgb name="rgb" type="color3"><input name="in" type="color3" nodename="hsv" /></hsvtorgb>
    <output name="out" type="color3" nodename="rgb" />
  </nodegraph>
  <nodegraph name="rings">
    <texcoord name="uv" type="vector2" />
    <subtract name="centered" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="0.5" /></subtract>
    <magnitude name="radius" type="float"><input name="in" type="vector2" nodename="centered" /></magnitude>
    <multiply name="frequency" type="float"><input name="in1" type="float" nodename="radius" /><input name="in2" type="float" value="40" /></multiply>
    <sin name="wave" type="float"><input name="in" type="float" nodename="frequency" /></sin>
    <remap name="unit" type="float"><input name="in" type="float" nodename="wave" /><input name="inlow" type="float" value="-1" /></remap>
    <mix name="color" type="color3">
      <input name="fg" type="color3" value="1, 0.5, 0.1" /><input name="bg" type="color3" value="0.05, 0.05, 0.1" />
      <input name="mix" type="float" nodename="unit" />
    </mix>
    <output name="out" type="color3" nodename="color" />
  </nodegraph>
</materialx>
